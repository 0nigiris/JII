 extends Node2D
 
+# JII integration — not part of the original game. Records the ending the first time the
+# fight is won so the installer can pick it up. See jii_marker.gd.
+const JiiMarker = preload("res://jii_marker.gd");
+var jiiRecorded:bool = false;
+
+func JiiWin(ending:String):
+	if (jiiRecorded): return;
+	jiiRecorded = true;
+	JiiMarker.write("chaos-install", ending);
