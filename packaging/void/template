# Template file for 'jii' — prebuilt-binary (static musl, no compile).
#
# Drop this at srcpkgs/jii/template in a void-packages checkout and build with
# `./xbps-src pkg jii`. The release binary is a static musl build, so no cross-toolchain
# and no runtime deps. Checksums below are the release tarballs' sha256 (Void uses sha256);
# refresh them with `./xbps-src update-check` / `xgensum -f` on each release bump.
pkgname=jii
version=0.1.21beta
revision=1
short_desc="Smart universal package installer for Linux"
maintainer="0nigiris <0nigiris@users.noreply.github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/0nigiris/JII"

_tag="v0.1.21-beta"
case "$XBPS_TARGET_MACHINE" in
	x86_64)  _arch=x86_64;  checksum=caf72a9507deea43afb5926d12cdece51225806f2c0e0d29bfdfce08162c7725 ;;
	aarch64) _arch=aarch64; checksum=eeeb6f4159d631b1a372cae85f1da82d66732fa1786f9a140918dadb5d4c6cdf ;;
	*) broken="no prebuilt JII binary for this architecture" ;;
esac
distfiles="${homepage}/releases/download/${_tag}/jii-${_tag}-${_arch}-linux.tar.gz"
wrksrc="jii-${_tag}-${_arch}-linux"

do_install() {
	vbin jii
	vman jii.1
	vcompletion completions/jii.bash bash
	vcompletion completions/_jii zsh
	vcompletion completions/jii.fish fish
	vlicense LICENSE
	vdoc README.md
}
