# Maintainer: 0nigiris <0nigiris@users.noreply.github.com>
#
# Prebuilt-binary AUR package: installs the static musl binary from the JII GitHub
# release, so users get `yay -S jii-bin` with no Rust toolchain and no compile.
# On each new release, bump pkgver and run `updpkgsums` to refresh the checksums,
# then `makepkg --printsrcinfo > .SRCINFO` and push. See packaging/README.md.
pkgname=jii-bin
_pkgname=jii
pkgver=0.1.20_beta
pkgrel=1
pkgdesc="A smart universal package installer for Linux — searches DNF/Flatpak/GitHub/Cargo/npm/…, ranks, installs the best, explains why"
arch=('x86_64' 'aarch64')
url="https://github.com/0nigiris/JII"
license=('GPL-3.0-or-later')
provides=('jii')
conflicts=('jii')
# pkgver may not contain a hyphen; reconstruct the real tag (v0.1.0-beta) from it.
_tag="v${pkgver//_/-}"
source_x86_64=("jii-${pkgver}-x86_64.tar.gz::${url}/releases/download/${_tag}/jii-${_tag}-x86_64-linux.tar.gz")
source_aarch64=("jii-${pkgver}-aarch64.tar.gz::${url}/releases/download/${_tag}/jii-${_tag}-aarch64-linux.tar.gz")
# Digests of the v0.1.20-beta release tarballs. Refresh with `updpkgsums` on each bump.
sha256sums_x86_64=('15efe4b219966ec592c14d24cf90636566c367e2d3e1afc37c660518fea6593f')
sha256sums_aarch64=('51ddcba262c4d57d6c3cc0c88e6002b225dcbf554d39edb0d24fbd663a3e6322')

package() {
  cd "${srcdir}/jii-${_tag}-${CARCH}-linux"
  install -Dm755 jii "${pkgdir}/usr/bin/jii"
  install -Dm644 jii.1 "${pkgdir}/usr/share/man/man1/jii.1"
  install -Dm644 completions/jii.bash "${pkgdir}/usr/share/bash-completion/completions/jii"
  install -Dm644 completions/_jii "${pkgdir}/usr/share/zsh/site-functions/_jii"
  install -Dm644 completions/jii.fish "${pkgdir}/usr/share/fish/vendor_completions.d/jii.fish"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
}
